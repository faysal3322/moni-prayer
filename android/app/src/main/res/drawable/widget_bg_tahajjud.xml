<?xml version="1.0" encoding="utf-8"?>
<!-- তাহাজ্জুদ — শেষ রাত: গাঢ় বেগুনি
     উপর থেকে নিচে গ্রেডিয়েন্ট (angle 270 = উপর→নিচ)। রং বদলাতে চাইলে নিচের
     তিনটা hex (উপর / মাঝ / নিচ) বদলান। কোণের গোলাকার ভাব: corners radius। -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#FF3B2A78"
        android:centerColor="#FF241A55"
        android:endColor="#FF0A0820" />
    <corners android:radius="20dp" />
</shape>
