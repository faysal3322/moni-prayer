<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MainActivity extends FlutterFragmentActivity (needed by audio_service
         for the media notification), which requires an AppCompat-based theme.
         The previous plain android:style theme caused an immediate crash on
         launch ("You need to use a Theme.AppCompat theme (or descendant)"). -->
    <style name="LaunchTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="NormalTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
