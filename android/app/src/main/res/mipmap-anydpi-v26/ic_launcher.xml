<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ (API 26+) এ এই XML ব্যবহার হয়, নিচের res/mipmap-*/
     ফোল্ডারের ic_launcher.png গুলো পুরনো Android ভার্সনের জন্য fallback। -->
