<?xml version="1.0" encoding="utf-8"?>
<!-- নিষিদ্ধ সময়ের লাল ব্যাকগ্রাউন্ড — শুধু দিনে ৩ বার (সূর্যোদয়ের পর ১৫ মিনিট,
     যাওয়াল ±৫ মিনিট, সূর্যাস্তের ১৫ মিনিট আগে) ব্যবহার হয়।
     উপর থেকে নিচে: উজ্জ্বল লাল → গাঢ় লাল (angle 270 = উপর→নিচ)।
     রং বদলাতে চাইলে নিচের তিনটা hex (উপর / মাঝ / নিচ) বদলান। -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#FFE43623"
        android:centerColor="#FFB02A19"
        android:endColor="#FF7F1B0C" />
    <corners android:radius="20dp" />
</shape>
