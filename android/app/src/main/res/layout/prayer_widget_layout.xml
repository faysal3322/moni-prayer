<?xml version="1.0" encoding="utf-8"?>
<!-- ফিক্স: আগে widget_time ও তার নিচের বার/আবহাওয়া সারিতে বড়
     নেগেটিভ মার্জিন (-20dp, -23dp) ব্যবহার করা হতো, যা কিছু ডিভাইসে/
     লঞ্চারে widget-কে দেওয়া প্রকৃত height কম হলে কনটেন্টকে widget-এর
     উপরের সীমানার বাইরে ঠেলে দিত — ফলে সময়/বার/তারিখের প্রথম অংশ কেটে
     (clip হয়ে) যেত (স্ক্রিনশটে ঠিক এই সমস্যাটাই দেখা গেছে)। এখন সব
     নেগেটিভ মার্জিন সরিয়ে স্বাভাবিক প্রবাহে (স্বাভাবিক পজিটিভ/শূন্য
     মার্জিন দিয়ে) রাখা হয়েছে, যাতে বিভিন্ন স্ক্রিন সাইজ/ডেনসিটি/
     লঞ্চারেও উপরের অংশ সবসময় সম্পূর্ণ দেখা যায়। -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- সময় — center -->
    <!-- ফিক্স: আগে এখানে autoSizeTextType/autoSizeMinTextSize/
         autoSizeMaxTextSize attribute ছিল। এগুলো RemoteViews (App
         Widget)-এ Android framework-এর সীমিত view set-এর বাইরে —
         normal Activity-তে কাজ করলেও widget-এ কিছু ডিভাইসে (বিশেষত
         Huawei/EMUI) inflate করার সময় unsupported attribute হিসেবে
         ধরা পড়ে পুরো widget-ই লোড হতে ব্যর্থ হয়ে "Problem loading
         widget" দেখাত। তাই এগুলো সরিয়ে একটা স্থির টেক্সট সাইজ রাখা
         হয়েছে, যেটা সব ডিভাইসে নির্ভরযোগ্যভাবে কাজ করে। -->
    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:gravity="center" />

    <!-- বার + আবহাওয়া পাশাপাশি -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_weather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:text=""
            android:textColor="#80DEEA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="start" />

    </LinearLayout>

    <!-- তারিখ + নামাজ পাশাপাশি -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <!-- বাম: তারিখ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_gregorian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_hijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_bangla_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="#80DEEA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- ডান: নামাজের সময় -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_sunrise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_sunset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_sehri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_iftar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text=""
                android:textColor="#00E676"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true" />

        </LinearLayout>
    </LinearLayout>

    <!-- নিচে alert -->
    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="#55000000"
        android:text=""
        android:textColor="#FFD54F"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="start"
        android:maxLines="8"
        android:ellipsize="end" />

</LinearLayout>
