<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1B2E1F"
    android:padding="12dp"
    android:gravity="center">

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello Widget"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#A5D6A7"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_gregorian"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#E0E0E0"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_hijri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD54F"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_sunrise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD54F"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_sunset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFD54F"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_sehri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#81C784"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_iftar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#81C784"
        android:textSize="10sp" />
</LinearLayout>
